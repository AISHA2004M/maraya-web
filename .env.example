# ══════════════════════════════════════════════════════════════════════════════
# Vrital — Backend Environment Configuration
# Copy this to backend/.env and fill in real values.
# All secrets marked with *** MUST be changed before production deployment.
# ══════════════════════════════════════════════════════════════════════════════

# ── App Identity ──────────────────────────────────────────────────────────────
PROJECT_NAME=Virtual Try-On API
API_V1_STR=/api/v1
ENVIRONMENT=production           # development | staging | production

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: Full URL (Supabase, Neon, Render PostgreSQL, etc.)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Option B: Individual parts (avoids URL-encoding issues with special chars)
# DB_HOST=db.supabase.co
# DB_USER=postgres
# DB_PASSWORD=your_password_here     # *** CHANGE IN PRODUCTION
# DB_NAME=postgres
# DB_PORT=6543

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_super_secret_key_in_production  # *** CHANGE IN PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FORMAT=json      # json (production) | pretty (development)
LOG_LEVEL=INFO       # DEBUG | INFO | WARNING | ERROR

# ── Error Tracking (Sentry) ───────────────────────────────────────────────────
# Get your DSN from https://sentry.io — leave blank to disable
SENTRY_DSN=

# ── Cloud Storage ─────────────────────────────────────────────────────────────
# Set USE_S3=true in production to enable S3/Cloudinary uploads
USE_S3=false
S3_BUCKET=vrital-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key    # *** CHANGE IN PRODUCTION
# S3_ENDPOINT_URL=                  # For S3-compatible (R2, MinIO, etc.)

# Cloudinary (free alternative to S3 for image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=              # *** CHANGE IN PRODUCTION

# ── AI Services ───────────────────────────────────────────────────────────────
# Priority 1: Gemini Image Generation (Nano Banana 2 gateway)
GEMINI_API_KEY=your_gemini_api_key_here
NANO_BANANA_API_KEY=your_gemini_api_key_here
NANO_BANANA_MODEL=gemini-3.1-flash-image-preview

# Priority 2a: Replicate IDM-VTON cloud
REPLICATE_API_TOKEN=your_replicate_token_here

# Priority 2b: HuggingFace (for local IDM-VTON bridge)
HF_TOKEN=your_huggingface_token_here

# Priority 2c: Local IDM-VTON bridge server
AI_SERVICE_URL=http://localhost:8001

# Priority 3: OpenRouter (alternative LLM/image provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Email (for welcome emails) ─────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@vrital.com
# SMTP_PASSWORD=your_smtp_password  # *** CHANGE IN PRODUCTION

# ── Frontend env (Vite — prefix with VITE_) ───────────────────────────────────
# These go in frontend/.env (not backend/.env)
# VITE_API_URL=https://vrital-api.onrender.com
# VITE_SENTRY_DSN=                  # Frontend Sentry DSN (optional)
